# Beispiel-Konfiguration für victor-ai-assistant (NUR Platzhalter, keine echten Werte).
# Kopieren: cp .env.example .env  — und dort die echten Werte eintragen.
# .env steht in .gitignore und wird nie committed.

PORT=5051
PUBLIC_BASE_URL=
AGENT_NAME=Victor
AGENT_LANGUAGE=de

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

PRINCIPAL_FULL_NAME=
PRINCIPAL_FIRST_NAME=
PRINCIPAL_LAST_NAME=
PRINCIPAL_DOB=
PRINCIPAL_PHONE=
PRINCIPAL_PHONE_E164=
PRINCIPAL_STREET=
PRINCIPAL_HOUSE_NO=
PRINCIPAL_ZIP=
PRINCIPAL_CITY=
